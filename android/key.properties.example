# Copy to android/key.properties (gitignored) and fill in real values.
# storeFile is resolved relative to android/app/.
# For a PKCS12 keystore (keytool default) keyPassword must equal storePassword.
# Without key.properties, release builds fall back to the debug key.
storePassword=CHANGE_ME
keyPassword=CHANGE_ME
keyAlias=CHANGE_ME
storeFile=upload-keystore.jks
