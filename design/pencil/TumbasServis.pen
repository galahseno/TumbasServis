        {
          "type": "note",
          "id": "s1nKm",
          "name": "S19 Note · Tablet-Landscape layout",
          "width": 380,
          "height": 365,
          "content": "Large: rail 240 + list pane 420 + detail pane. List-detail: the selected card (border-accent) drives the detail pane, which shows that booking's S20 overview (header, fleet progress, unit list); 'Buka detail' opens the full S20 page. Tabs scroll inside the 420 dp list pane. No selection = EmptyState in the pane."
        },
        {
          "type": "note",
          "id": "pRBbN",
          "name": "Semantics note",
          "width": 380,
          "height": 300,
          "content": "SEMANTICS — list-detail: the selected card announces 'dipilih'; the detail pane is a labelled region 'Detail booking TS-260929-0417' and 'Buka detail' is a link to the full S20 page. Tab row and cards behave as on the phone."
        }
      ]
    },
    {
      "type": "frame",
