              "name": "Section Note",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Glass bar (standard 42 % glass-tint, blur 28, 1 px glass-border, sheen top + bottom, no fixed height). Left: Estimasi + duration (Body Small) over the total, both text-heading; right: the Lanjut CTA. Text on the bar is text-heading only (text-body falls to 4.3 : 1 light / 2.9 : 1 dark over a solid accent fill). Sits above the gesture inset, 16 dp from the sides. Disabled adds a reason line; loading swaps the total for a skeleton; error offers 'Coba lagi'.",
              "lineHeight": "$type-body-sm-lh",
              "fontFamily": "$font-family",
              "fontSize": "$type-body-sm-size",
              "fontWeight": "$font-weight-regular",
              "letterSpacing": "$type-body-sm-tracking"
