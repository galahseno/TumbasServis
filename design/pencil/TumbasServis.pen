              "name": "Rule Dark",
              "fill": "$text-body",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Dark mode: shadows nearly vanish on near-black (surface-card vs bg-page is only 1.07 : 1). Card separation there comes from the tone step plus a 1px border-subtle stroke, so every card, tile and sheet carries border-subtle in both modes. Shadows add depth, they never carry the boundary.",
              "lineHeight": "$type-body-sm-lh",
              "fontFamily": "$font-family",
              "fontSize": "$type-body-sm-size",
              "fontWeight": "$font-weight-regular",
              "letterSpacing": "$type-body-sm-tracking"
            },
