              "type": "text",
              "id": "JFqNB",
              "name": "Rule Usage",
              "fill": "$text-body",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "Use shadow-sm for cards at rest, shadow-md for sheets and dialogs, shadow-accent on the primary booking CTA only. Glass surfaces use their own glass-shadow pair, not shadow-sm or shadow-md.",
              "lineHeight": "$type-body-sm-lh",
              "fontFamily": "$font-family",
              "fontSize": "$type-body-sm-size",
              "fontWeight": "$font-weight-regular",
              "letterSpacing": "$type-body-sm-tracking"
