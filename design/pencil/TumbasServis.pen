    {
      "type": "frame",
      "id": "G06QB3",
      "x": 2640,
      "y": 57715,
      "name": "S19 Handoff Notes · Phone",
      "width": 380,
      "fill": "$surface-inset",
      "layout": "vertical",
      "gap": 8,
      "padding": 12,
      "children": [
        {
          "type": "note",
          "id": "KZMm3",
          "name": "Note",
          "width": 0,
          "height": 237,
          "content": "Status tab = derived booking status: all Terjadwal → Mendatang; any unit past check-in → Berlangsung; all Selesai → Selesai; cancelled → Dibatalkan. Counts update live."
        },
        {
          "type": "note",
          "id": "Q9p7p",
          "name": "Note",
          "width": 0,
          "height": 219,
          "content": "Tap card → S20 Detail Booking. Dibatalkan = terminal; rebook lewat 'Booking lagi' di S20."
        },
        {
          "type": "note",
          "id": "j4wQ3",
          "name": "Note",
          "width": 0,
          "height": 219,
          "content": "Setiap perubahan status unit menyinkronkan kartu S05, daftar S19, S20, S21 live + push notifikasi S06."
        },
        {
          "type": "note",
          "id": "fOKJy",
          "name": "Note",
          "width": 0,
          "height": 219,
          "content": "Motion: tab switch 150 ms ease-out; kartu enter 300 ms staggered; reduce-motion → fade saja, tanpa stagger."
        },
        {
          "type": "note",
          "id": "T6o6Kw",
          "name": "Note",
          "width": 0,
          "height": 219,
          "content": "Loading: chrome asli (app bar + tabs) + 3 skeleton card (shimmer loop). Empty per-tab pakai EmptyState tanpa CTA, kecuali Mendatang (CTA 'Booking servis')."
        },
        {
          "type": "note",
          "id": "x1shX",
          "name": "Note",
          "width": 0,
          "height": 342,
          "content": "TABS — scrollable underline tabs (label + count, 48 dp hit height, full-bleed row, first label on the 16 dp gutter). Active tab scrolls into view, edge fade shows hidden tabs. Selected = accent label + 3 dp indicator + bold (never colour alone). Tab switch keeps the scroll offset."
        },
        {
          "type": "note",
          "id": "LCPdr",
          "name": "Note",
          "width": 0,
          "height": 237,
          "content": "FILTER BY MOTOR — S09 'Lihat semua' opens S19 with a dismissible chip above the tabs (e.g. 'Beat 110 ×'); tab counts recompute for that motor; empty copy unchanged. Annotation only, no frame."
        },
        {
          "type": "note",
          "id": "CQ289",
          "name": "Semantics note",
          "width": 0,
          "height": 438,
          "content": "SEMANTICS — Tab row = TabBar: each tab announces 'Berlangsung, 1 booking, tab 2 dari 4, dipilih'; arrow keys move between tabs; the selected tab keeps the accent indicator (never colour alone). Booking card = one button: 'TS-260929-0417, Bengkel Jaya Motor, Sel 29 Sep 2026, 3 motor, Berlangsung'. Skeleton rows stay out of the tree; announce 'Memuat riwayat' once (live region). Tab counts use tabular figures."
        }
      ]
    },
