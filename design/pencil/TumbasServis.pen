      "gap": 40,
      "padding": 48,
      "children": [
        {
          "type": "frame",
          "id": "Qr9L0",
          "name": "Board Header",
          "width": "fill_container",
          "layout": "vertical",
          "gap": 8,
          "children": [
            {
              "type": "text",
              "id": "GPZML",
              "name": "Board Title",
              "fill": "$text-heading",
              "content": "S11 blocks",
              "lineHeight": "$type-headline-lg-lh",
              "fontFamily": "$font-family",
              "fontSize": "$type-headline-lg-size",
              "fontWeight": "$font-weight-semibold",
              "letterSpacing": "$type-headline-lg-tracking"
            },
            {
              "type": "text",
              "id": "lLOsM",
              "name": "Board Description",
              "fill": "$text-muted",
              "textGrowth": "fixed-width",
              "width": "fill_container",
              "content": "S11 Detail servis parts (step 07): the unit tab chip with its status glyph kept when active (amends step 04), the step app bar (back + close), UnitHeader, the Salin dari row, note and source sheet, ComplaintSection and a design-only keyboard. The booking flow has no NavBar / NavRail.",
              "lineHeight": "$type-body-md-lh",
              "fontFamily": "$font-family",
              "fontSize": "$type-body-md-size",
